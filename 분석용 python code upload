# 2️⃣ 유입 시점 패턴 분석

import pandas as pd
import matplotlib.pyplot as plt

# 한글 폰트 깨짐 방지
plt.rcParams['font.family'] = 'AppleGothic'
plt.rcParams['axes.unicode_minus'] = False

# CSV 불러오기
df = pd.read_csv("visitlogs_final.csv")

# visited_at → datetime으로 변환
df['visited_at'] = pd.to_datetime(df['visited_at'], errors='coerce')

# 요일/시간 컬럼 추가
df['weekday'] = df['visited_at'].dt.day_name()   # Monday, Tuesday ...
df['hour'] = df['visited_at'].dt.hour

# 요일 순서 정렬용
weekday_order = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
df['weekday'] = pd.Categorical(df['weekday'], categories=weekday_order, ordered=True)

# 캠페인 결측 처리
df['utm_campaign'] = df['utm_campaign'].fillna('unknown')

# ✅ 1️⃣ 요일별 캠페인 방문량
weekday_pivot = (
    df.groupby(['weekday', 'utm_campaign'])
    .size()
    .unstack(fill_value=0)
)

weekday_pivot.plot(kind='bar', figsize=(10,6))
plt.title("캠페인별 요일별 방문량")
plt.ylabel("방문 수")
plt.xlabel("요일")
plt.legend(title="캠페인")
plt.tight_layout()
plt.show()


# ✅ 2️⃣ 시간대별 캠페인 방문량
hour_pivot = (
    df.groupby(['hour', 'utm_campaign'])
    .size()
    .unstack(fill_value=0)
)

hour_pivot.plot(kind='line', figsize=(10,6), marker='o')
plt.title("캠페인별 시간대별 방문 추이")
plt.ylabel("방문 수")
plt.xlabel("시간대 (0~23시)")
plt.legend(title="캠페인")
plt.tight_layout()
plt.show()

