# 3️⃣ 캠페인별 유입 효율 매트릭스

import pandas as pd

# CSV 불러오기
df = pd.read_csv("visitlogs_final.csv")

# 결측 처리
df['utm_campaign'] = df['utm_campaign'].fillna('unknown')
df['utm_source'] = df['utm_source'].fillna('unknown')
df['device_family'] = df['device_family'].fillna('unknown')

# ✅ 1️⃣ 캠페인별 세션수
session_count = df.groupby('utm_campaign').size().rename('sessions')

# ✅ 2️⃣ 모바일 비중
mobile_ratio = (
    df.groupby('utm_campaign')['device_family']
    .apply(lambda x: (x.str.lower() == 'mobile').mean() * 100)
    .rename('mobile_ratio')
)

# ✅ 3️⃣ direct 비중
direct_ratio = (
    df.groupby('utm_campaign')['utm_source']
    .apply(lambda x: (x.str.lower() == 'direct').mean() * 100)
    .rename('direct_ratio')
)

# ✅ 4️⃣ 주요 채널 (상위 2개 source)
top_sources = (
    df.groupby(['utm_campaign', 'utm_source'])
    .size()
    .groupby(level=0)
    .apply(lambda x: ', '.join(x.nlargest(2).index.get_level_values(1)))
    .rename('top_sources')
)

# ✅ 통합 매트릭스 생성
summary = pd.concat([session_count, mobile_ratio, direct_ratio, top_sources], axis=1).reset_index()

# 소수점 정리
summary['mobile_ratio'] = summary['mobile_ratio'].round(1)
summary['direct_ratio'] = summary['direct_ratio'].round(1)

print("📊 캠페인별 유입 효율 매트릭스\n")
print(summary)

